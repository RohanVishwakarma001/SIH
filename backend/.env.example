NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medikiosk?schema=public"

# In production these MUST be changed to real high-entropy secrets — the server
# refuses to start in production with the development defaults below.
JWT_SECRET="medikiosk_jwt_secret_development_key_super_secure_2026"
JWT_REFRESH_SECRET="medikiosk_jwt_refresh_secret_key_super_secure_2026"

FRONTEND_URL="http://localhost:5173"
# Comma-separated list of additional allowed CORS origins in production
# (FRONTEND_URL is always allowed; *.vercel.app and *.onrender.com are always allowed too).
# Ignored in development, where all origins are allowed.
CORS_ORIGIN=""

# Swagger UI (/docs) defaults to ON in development and OFF in production.
# Set explicitly to override: "true" or "false"
# ENABLE_SWAGGER=""

AI_PROVIDER="mock"
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# "local" writes uploaded documents to STORAGE_PATH on local disk — fine for development,
# but NOT durable on most production hosts (files are lost on redeploy/restart).
# Set STORAGE_DRIVER=s3 (with the STORAGE_* variables below) or STORAGE_DRIVER=cloudinary
# (with the CLOUDINARY_* variables below) for production.
STORAGE_DRIVER="local"
STORAGE_PATH="./uploads"
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"

# Used when STORAGE_DRIVER=cloudinary. Find these in your Cloudinary Dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

LOG_LEVEL="info"
