datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PATIENT
  DOCTOR
  STAFF
  ADMIN
}

enum PriorityLevel {
  NORMAL
  ATTENTION
  URGENT
}

enum SessionStatus {
  CREATED
  CONSENT_PENDING
  INTERVIEW
  DOCUMENTS
  REVIEW
  COMPLETED
  ABANDONED
}

enum ConsentStatus {
  ACTIVE
  REVOKED
}

enum HistoryStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  VERIFIED
}

enum QueueStatus {
  WAITING
  IN_KIOSK
  READY
  WITH_DOCTOR
  COMPLETED
}

enum DocumentType {
  PRESCRIPTION
  LAB_REPORT
  DISCHARGE_SUMMARY
  IMAGING
  OTHER
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EntityCategory {
  DIAGNOSIS
  MEDICATION
  INVESTIGATION
  DATE
  DOCTOR
}

enum SummaryStatus {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(STAFF)
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  consultations       Consultation[]
  acknowledgedAlerts  TriageAlert[]
  correctedEntities   EntityCorrection[]
  summaryRevisions    SummaryRevision[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  city      String
  state     String
  createdAt DateTime @default(now())

  departments   Department[]
  kioskTerminals KioskTerminal[]
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nativeName  String?
  description String
  icon        String   @default("Stethoscope")
  avgWaitMins Int      @default(12)
  hospitalId  String?
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])

  patients        Patient[]
  patientSessions PatientSession[]

  @@index([code])
}

model KioskTerminal {
  id                  String   @id @default(uuid())
  terminalCode        String   @unique
  location            String
  status              String   @default("Ready")
  ipAddress           String?
  activeLanguage      String   @default("hi")
  currentPatientToken String?
  hospitalId          String?
  hospital            Hospital? @relation(fields: [hospitalId], references: [id])

  sessions            PatientSession[]
  triageAlerts        TriageAlert[]

  @@index([terminalCode])
}

model Patient {
  id                  String        @id @default(uuid())
  token               String        @unique
  roomNo              String        @default("Room 04")
  name                String
  nameHindi           String?
  age                 Int
  gender              String
  phone               String
  abhaId              String?
  abhaAddress         String?
  abhaVerified        Boolean       @default(false)
  priority            PriorityLevel @default(NORMAL)
  queueStatus         QueueStatus   @default(WAITING)
  historyStatus       HistoryStatus @default(NOT_STARTED)
  waitTimeMinutes     Int           @default(10)
  checkedInTime       String
  chiefComplaintShort String
  
  // Vitals
  bp                  String        @default("120/80")
  heartRate           Int           @default(72)
  spo2                Int           @default(98)
  temperature         String        @default("98.6 °F")
  bmi                 Float         @default(22.5)
  bloodSugar          Int?

  departmentId        String
  department          Department    @relation(fields: [departmentId], references: [id])

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions            PatientSession[]
  consents            Consent[]
  interviews          ClinicalInterview[]
  clinicalHistories   ClinicalHistory[]
  documents           Document[]
  timelineEvents      MedicalTimelineEvent[]
  redFlags            RedFlag[]
  clinicalSummaries   ClinicalSummary[]
  consultations       Consultation[]

  @@index([token])
  @@index([phone])
  @@index([abhaId])
  @@index([priority])
  @@index([queueStatus])
}

model PatientSession {
  id               String        @id @default(uuid())
  sessionId        String        @unique @default(uuid())
  patientId        String?
  patient          Patient?      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kioskTerminalId  String?
  kioskTerminal    KioskTerminal? @relation(fields: [kioskTerminalId], references: [id])
  departmentId     String
  department       Department    @relation(fields: [departmentId], references: [id])
  language         String        @default("hi")
  status           SessionStatus @default(CREATED)
  currentStep      Int           @default(1)
  estimatedWaitMins Int          @default(8)
  startedAt        DateTime      @default(now())
  completedAt      DateTime?

  consents         Consent[]
  interviews       ClinicalInterview[]
  redFlags         RedFlag[]

  @@index([sessionId])
  @@index([patientId])
  @@index([status])
}

model Consent {
  id                 String        @id @default(uuid())
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId          String
  session            PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  consentAi          Boolean       @default(true)
  consentDoctorShare Boolean       @default(true)
  consentAbha        Boolean       @default(true)
  version            String        @default("1.0")
  status             ConsentStatus @default(ACTIVE)
  revokedAt          DateTime?
  revokeReason       String?
  timestamp          DateTime      @default(now())

  @@index([patientId])
  @@index([sessionId])
}

model ClinicalInterview {
  id               String         @id @default(uuid())
  patientId        String
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId        String
  session          PatientSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  departmentId     String
  currentStep      Int            @default(1)
  totalSteps       Int            @default(7)
  status           String         @default("IN_PROGRESS")
  redFlagDetected  Boolean        @default(false)
  startedAt        DateTime       @default(now())
  completedAt      DateTime?

  questions        InterviewQuestion[]
  answers          InterviewAnswer[]
  clinicalHistories ClinicalHistory[]
  clinicalSummaries ClinicalSummary[]

  @@index([patientId])
  @@index([sessionId])
}

model InterviewQuestion {
  id             String            @id @default(uuid())
  interviewId    String
  interview      ClinicalInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionCode   String
  stepNumber     Int
  category       String
  questionText   String
  inputType      String
  isAyush        Boolean           @default(false)
  ayushDimension String?

  answers        InterviewAnswer[]

  @@index([interviewId])
  @@index([questionCode])
}

model InterviewAnswer {
  id                 String            @id @default(uuid())
  interviewId        String
  interview          ClinicalInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId         String
  question           InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerType         String
  selectedOptions    Json?
  scaleValue         Int?
  textValue          String?
  rawVoiceTranscript String?
  confidence         Float?
  isRedFlagTriggered Boolean           @default(false)
  timestamp          DateTime          @default(now())

  @@index([interviewId])
  @@index([questionId])
}

model ClinicalHistory {
  id                     String            @id @default(uuid())
  patientId              String
  patient                Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  interviewId            String?
  interview              ClinicalInterview? @relation(fields: [interviewId], references: [id])
  
  chiefComplaintPrimary  String
  onset                  String
  duration               String
  severityScore          Int               @default(5)
  location               String
  aggravatingFactors     Json?
  relievingFactors       Json?
  hpiNarrative           String
  pastMedicalHistory     Json?
  pastSurgicalHistory    Json?
  drugHistory            Json?
  allergyHistory         Json?
  familyHistory          Json?
  personalHistory        Json?
  reviewOfSystems        Json?
  previousInvestigations Json?
  status                 String            @default("DRAFT")

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  ayushAssessment        AyushAssessment?

  @@index([patientId])
}

model AyushAssessment {
  id                       String          @id @default(uuid())
  clinicalHistoryId        String          @unique
  clinicalHistory          ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)
  patientId                String
  prakritiVata             Int             @default(40)
  prakritiPitta            Int             @default(35)
  prakritiKapha            Int             @default(25)
  primaryDosha             String          @default("Vata-Pitta")
  vikriti                  String
  sara                     String          @default("Madhyama")
  samhanana                String          @default("Madhyama")
  pramana                  String          @default("Prakrita")
  satmya                   String          @default("Satmya")
  satva                    String          @default("Madhyama")
  aharaShaktiAbhyavaharana String
  aharaShaktiJarana        String
  vyayamaShakti            String          @default("Madhyama")
  vaya                     String          @default("Madhyama")
  createdAt                DateTime        @default(now())

  @@index([patientId])
}

model Document {
  id              String        @id @default(uuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title           String
  documentType    DocumentType  @default(PRESCRIPTION)
  fileUrl         String
  storageKey      String
  facility        String?
  doctorName      String?
  date            String?
  ocrStatus       OcrStatus     @default(PENDING)
  confidenceScore Float         @default(0.0)
  rawOcrText      String?
  createdAt       DateTime      @default(now())

  ocrResults      OCRResult[]
  medicalEntities MedicalEntity[]
  timelineEvents  MedicalTimelineEvent[]

  @@index([patientId])
  @@index([documentType])
  @@index([ocrStatus])
}

model OCRResult {
  id              String          @id @default(uuid())
  documentId      String
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rawText         String
  confidenceScore Float
  processingTimeMs Int            @default(1500)
  processedAt     DateTime        @default(now())

  entities        MedicalEntity[]

  @@index([documentId])
}

model MedicalEntity {
  id               String             @id @default(uuid())
  ocrResultId      String?
  ocrResult        OCRResult?         @relation(fields: [ocrResultId], references: [id], onDelete: Cascade)
  documentId       String
  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  category         EntityCategory
  value            String
  standardizedName String?
  dosage           String?
  frequency        String?
  confidence       Float              @default(95.0)
  isVerified       Boolean            @default(false)
  boundingBox      Json?
  createdAt        DateTime           @default(now())

  corrections      EntityCorrection[]

  @@index([documentId])
  @@index([category])
}

model EntityCorrection {
  id                String        @id @default(uuid())
  entityId          String
  entity            MedicalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  previousValue     String
  correctedValue    String
  correctedByUserId String?
  correctedByUser   User?         @relation(fields: [correctedByUserId], references: [id])
  correctedAt       DateTime      @default(now())

  @@index([entityId])
}

model MedicalTimelineEvent {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date        String
  yearMonth   String
  title       String
  category    String
  facility    String
  summary     String
  badgeText   String
  isImportant Boolean   @default(false)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([patientId])
  @@index([yearMonth])
}

model RedFlag {
  id                String         @id @default(uuid())
  patientId         String
  patient           Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId         String?
  session           PatientSession? @relation(fields: [sessionId], references: [id])
  title             String
  description       String
  symptoms          Json
  severity          String         @default("CRITICAL")
  status            String         @default("ACTIVE")
  triggeredAt       DateTime       @default(now())
  staffPagingStatus String         @default("DISPATCHED")
  staffPagedAt      DateTime       @default(now())

  triageAlerts      TriageAlert[]

  @@index([patientId])
  @@index([status])
}

model TriageAlert {
  id                   String        @id @default(uuid())
  redFlagId            String
  redFlag              RedFlag       @relation(fields: [redFlagId], references: [id], onDelete: Cascade)
  patientId            String
  kioskTerminalId      String?
  kioskTerminal        KioskTerminal? @relation(fields: [kioskTerminalId], references: [id])
  status               String        @default("PENDING")
  acknowledgedByUserId String?
  acknowledgedByUser   User?         @relation(fields: [acknowledgedByUserId], references: [id])
  acknowledgedAt       DateTime?
  nurseDispatchedAt    DateTime      @default(now())

  @@index([redFlagId])
  @@index([patientId])
}

model ClinicalSummary {
  id                         String            @id @default(uuid())
  patientId                  String
  patient                    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  interviewId                String?
  interview                  ClinicalInterview? @relation(fields: [interviewId], references: [id])
  conciseSummary             String
  keyPositiveFindings        Json
  pertinentNegatives         Json
  redFlagAlerts              Json
  differentialDiagnoses      Json
  recommendedInvestigations  Json
  status                     SummaryStatus     @default(PENDING)
  currentRevisionNumber      Int               @default(1)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  revisions                  SummaryRevision[]

  @@index([patientId])
  @@index([status])
}

model SummaryRevision {
  id                String          @id @default(uuid())
  clinicalSummaryId String
  clinicalSummary   ClinicalSummary @relation(fields: [clinicalSummaryId], references: [id], onDelete: Cascade)
  revisionNumber    Int
  summaryText       String
  modifiedByUserId  String?
  modifiedByUser    User?           @relation(fields: [modifiedByUserId], references: [id])
  action            String          @default("GENERATED")
  remarks           String?
  timestamp         DateTime        @default(now())

  @@index([clinicalSummaryId])
}

model Consultation {
  id                   String         @id @default(uuid())
  patientId            String
  patient              Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId             String
  doctor               User           @relation(fields: [doctorId], references: [id])
  provisionalDiagnosis String
  icdCode              String
  clinicalNotes        String
  orderedInvestigations Json?
  followUpDays         Int            @default(7)
  isPushedToAbha       Boolean        @default(false)
  abhaBundleId         String?
  savedAt              DateTime?
  createdAt            DateTime       @default(now())

  prescriptions        Prescription[]
  doctorNotes          DoctorNote[]

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medicine       String
  dosage         String
  frequency      String
  duration       String
  instructions   String
  createdAt      DateTime     @default(now())

  @@index([consultationId])
}

model DoctorNote {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  noteText       String
  createdAt      DateTime     @default(now())
}

model Notification {
  id              String   @id @default(uuid())
  type            String
  title           String
  message         String
  priority        String   @default("NORMAL")
  recipientRole   UserRole?
  recipientUserId String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientRole])
  @@index([recipientUserId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  role       String
  action     String
  resource   String
  resourceId String?
  details    String
  ipAddress  String?
  status     String   @default("SUCCESS")
  timestamp  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
}
